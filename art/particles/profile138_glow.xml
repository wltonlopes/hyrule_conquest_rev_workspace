<?xml version="1.0" encoding="utf-8"?>
<particles>

    <texture>art/textures/particles/stalfos_violetfireA.dds</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="77.0"/>
    <uniform name="lifetime" min="0.1" max="0.3"/>


    <uniform name="velocity.x" min="-5" max="5"/>
    <uniform name="velocity.y" min="-5" max="5"/>
    <uniform name="velocity.z" min="-5" max="5"/>
    <uniform name="velocity.angle" min="-5" max="5"/>

    <uniform name="size" min="12" max="12"/>
	
    <uniform name="color.b" min="9.8" max="10.0"/>
    <copy name="color.g" from="color.b"/>
    <copy name="color.r" from="color.b"/>

</particles>
